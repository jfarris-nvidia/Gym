version = "1.0"

[metadata]
name = "{task_id}"
difficulty = "{difficulty}"

[verifier]
timeout_sec = 1200

[agent]
timeout_sec = 7200

[environment]
build_timeout_sec = 600.0
cpus = 2
memory_mb = 8192
storage_mb = 20480
gpus = 0
allow_internet = true

[environment.env]
# Pass through NVIDIA gateway credentials for the agent (Claude Code reads these)
ANTHROPIC_API_KEY = "${OPENAI_API_KEY}"
ANTHROPIC_BASE_URL = "${OPENAI_BASE_URL}"
OPENAI_API_KEY = "${OPENAI_API_KEY}"
OPENAI_BASE_URL = "${OPENAI_BASE_URL}"

[verifier.env]
JUDGE_MODEL = "{judge_model}"
JUDGE_API_KEY = "${OPENAI_API_KEY}"
JUDGE_BASE_URL = "${OPENAI_BASE_URL}"
